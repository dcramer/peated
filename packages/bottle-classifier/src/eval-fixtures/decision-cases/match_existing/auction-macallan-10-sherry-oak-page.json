    "dbOutcome": {
      "bottleId": null,
      "createsBottle": false,
      "summary": "Production returned no_match: the title and 40% did not separate Sherry Oak 10 (1105) from Fine Oak 10 (5182) and two other 10-year-old releases."
    },
    "notes": "Saved check 36026, source auction_lot 16615 (lot 185-904787, lot number 185-01610). This is a second 'Macallan 10 Year Old' lot in the same auction, not lot 16620 judged earlier. Its page text says only '10 Years Old', '40% ABV / 70cl' and that the 10-year-old was discontinued in 2013; it does not say Sherry Oak, so the photo is what settles it. This case therefore follows the photo-case pattern even though the fixture id says 'page': input.reference.imageUrl is set to the lot's first photo at full size, and the evidence pack gets that photo's reviewed reading. Production ran without the photo; this case goes in with the change that makes auctions read the lot photo. The photo clearly shows the bottle and carton: The Macallan, Highland Single Malt Scotch Whisky, 10 Ten Years Old, 'Exclusively matured in selected sherry oak casks from Jerez, Spain', 700 ml. The bottle's ABV print is too small to read with confidence, so the reading leaves abv empty; the scraper's 40% stays in extractedIdentity. 1105 is The Macallan 10-year-old, Series Sherry Oak Collection, 40%. 5182 is the Fine Oak 10-year-old at 40%; 69113 and 69121 are special releases."
  },
  "expected": {
    "status": "classified",
    "action": "match",
    "identityScope": "product",
    "matchedBottleId": 1105,
    "summary": "Match The Macallan 10-year-old in the Sherry Oak range (1105). The label prints 'exclusively matured in selected sherry oak casks from Jerez, Spain', which rules out the Fine Oak 10 (5182) at the same age and ABV."
  },
  "knownFailure": {
    "reason": "The label photo is never read: auction runs extract only the lot details (40%), so the sherry oak wording can't be seen."
  }
