{
  "private": true,
  "name": "@peated/server",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "concurrently 'npm:dev:api' 'npm:dev:worker'",
    "dev:api": "tsx watch --require dotenv/config ./src/run-server.ts",
    "dev:worker": "tsx watch --require dotenv/config ./src/run-worker.ts",
    "start": "concurrently 'npm:start:api' 'npm:start:worker'",
    "start:api": "tsx --require dotenv/config ./src/run-server.ts",
    "start:worker": "tsx --require dotenv/config ./src/run-worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "sh -c 'if [ \"$1\" = \"--\" ]; then shift; fi; if [ -f .env.test.local ]; then dotenv -e .env.test -e .env.test.local -- vitest run \"$@\"; else dotenv -e .env.test -- vitest run \"$@\"; fi' --",
    "test:watch": "sh -c 'if [ \"$1\" = \"--\" ]; then shift; fi; if [ -f .env.test.local ]; then dotenv -e .env.test -e .env.test.local -- vitest watch \"$@\"; else dotenv -e .env.test -- vitest watch \"$@\"; fi' --",
    "test:ci": "sh -c 'if [ \"$1\" = \"--\" ]; then shift; fi; if [ -f .env.test.local ]; then dotenv -e .env.test -e .env.test.local -- vitest run --coverage --reporter=junit --reporter=default --outputFile=junit.xml \"$@\"; else dotenv -e .env.test -- vitest run --coverage --reporter=junit --reporter=default --outputFile=junit.xml \"$@\"; fi' --"
  },
  "dependencies": {
    "@faker-js/faker": "^8.4.1",
    "@google-cloud/storage": "^7.19.0",
    "@googlemaps/google-maps-services-js": "^3.4.2",
    "@hono/node-server": "^1.19.13",
    "@logtape/hono": "catalog:",
    "@logtape/logtape": "catalog:",
    "@logtape/redaction": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@paralleldrive/cuid2": "^2.2.2",
    "@peated/bottle-classifier": "workspace:*",
    "@peated/catalog-verifier": "workspace:*",
    "@peated/email": "workspace:*",
    "@peated/entity-classifier": "workspace:*",
    "@peated/orpc": "workspace:*",
    "@peated/tsconfig": "workspace:*",
    "@sentry/core": "catalog:",
    "@sentry/hono": "catalog:",
    "@sentry/node": "catalog:",
    "@simplewebauthn/server": "^13.3.0",
    "@sindresorhus/slugify": "^2.2.1",
    "@vitest/coverage-v8": "catalog:",
    "axios": "~1.19.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.40.3",
    "cheerio": "1.2.0",
    "concurrently": "^8.2.2",
    "dotenv": "catalog:",
    "dotenv-cli": "catalog:",
    "drizzle-kit": "catalog:",
