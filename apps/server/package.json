    "jsx-email": "catalog:",
    "mime-types": "^3.0.2",
    "nanoid": "^3.3.17",
    "nodemailer": "^9.0.1",
    "openai": "^6.27.0",
    "pg": "catalog:",
    "react": "catalog:",
    "sharp": "^0.33.5",
    "toad-scheduler": "^3.0.1",
