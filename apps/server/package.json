{
  "private": true,
  "name": "@peated/server",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "check:peated-bot-signature": "tsx ./scripts/check-peated-bot-signature.ts",
    "generate:peated-bot-key": "node ./scripts/generate-peated-bot-key.mjs",
    "dev": "concurrently 'npm:dev:api' 'npm:dev:worker'",
    "dev:api": "tsx watch --require dotenv/config ./src/run-server.ts",
    "dev:mock": "tsx watch ./src/orpc/mock/run-server.ts",
    "dev:worker": "tsx watch --require dotenv/config ./src/run-worker.ts",
    "evals": "sh -c 'if [ \"$1\" = \"--\" ]; then shift; fi; dotenv -e .env.test.local -e .env.test -- vitest run --config vitest.evals.config.mts \"$@\"' --",
    "start": "concurrently 'npm:start:api' 'npm:start:worker'",
    "start:api": "tsx --require dotenv/config ./src/run-server.ts",
    "start:worker": "tsx --require dotenv/config ./src/run-worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "sh -c 'if [ \"$1\" = \"--\" ]; then shift; fi; dotenv -e .env.test.local -e .env.test -- vitest run \"$@\"' --",
    "test:watch": "sh -c 'if [ \"$1\" = \"--\" ]; then shift; fi; dotenv -e .env.test.local -e .env.test -- vitest watch \"$@\"' --",
    "test:ci": "sh -c 'if [ \"$1\" = \"--\" ]; then shift; fi; dotenv -e .env.test.local -e .env.test -- vitest run --reporter=junit --reporter=default --outputFile=junit.xml \"$@\"' --"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
