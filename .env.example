# Copy this file to `.env.local` for local development.
# `.env.local` is intentionally ignored and should never be committed.

DATABASE_URL=postgresql://postgres:postgres@localhost:15432/peated
REDIS_URL=redis://@localhost:16379
JWT_SECRET=super-duper-s3cret
GOOGLE_CLIENT_ID=721909483682-iu10jr6ir9k0iju3tpujov0juvsm3745.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
# bypass email verification - useful for local development (unless you need to test the flows)
# SKIP_EMAIL_VERIFICATION=1
SENTRY_DSN=
SENTRY_PROJECT=
# needs `project:releases` scope
SENTRY_AUTH_TOKEN=
# Required in production, which always uses Vercel AI Gateway.
AI_GATEWAY_API_KEY=
# Optional: defaults to `openai/gpt-5.4`.
# OPENAI_MODEL=gpt-5.4
# The Bottle classifier has an independent, reproducible baseline.
# BOTTLE_CLASSIFIER_MODEL=gpt-5.6-terra
# BOTTLE_CLASSIFIER_REASONING_EFFORT=medium
# Required for classifier web evidence. Without it, no web-search tool is exposed.
# FIRECRAWL_API_KEY=
# FIRECRAWL_API_URL=https://api.firecrawl.dev
# OPENAI_IMAGE_EXTRACTION_MODEL=gpt-5.6-luna
# OPENAI_IMAGE_EXTRACTION_REASONING_EFFORT=high
# Optional for GPT-5: none, low, medium, high, or xhigh.
# Unset preserves the provider's default reasoning effort.
# OPENAI_REASONING_EFFORT=high
# Optional: defaults to `openai/text-embedding-3-large`.
# OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# Optional: separate judge settings for `pnpm evals:classifier`.
# Defaults to `gpt-5.6-luna` with `medium` reasoning.
# OPENAI_EVAL_MODEL=gpt-5.6-luna
# OPENAI_EVAL_REASONING_EFFORT=medium
# Optional: Firecrawl web-evidence budget per classifier eval case. Each search
# query and each focused page read consumes one unit.
# BOTTLE_CLASSIFIER_EVAL_MAX_SEARCH_QUERIES=3
UPLOAD_PATH=
USE_GCS_STORAGE=
GCS_BUCKET_NAME=
GCS_BUCKET_PATH=
