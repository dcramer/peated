SENTRY_AUTH_TOKEN=
AI_GATEWAY_API_KEY=
# Optional direct OpenAI fallback when AI_GATEWAY_API_KEY is unset.
OPENAI_API_KEY=
# Optional: defaults to `openai/gpt-5.4` with the gateway or `gpt-5.4` directly.
# OPENAI_MODEL=gpt-5.4
# OPENAI_IMAGE_EXTRACTION_MODEL=gpt-5.6-luna
# OPENAI_IMAGE_EXTRACTION_REASONING_EFFORT=high
# Optional for GPT-5: none, low, medium, high, or xhigh.
# Unset preserves the provider's default reasoning effort.
# OPENAI_REASONING_EFFORT=high
# Optional: defaults to the corresponding `text-embedding-3-large` model.
# OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# Optional: separate judge model for `pnpm evals:classifier`.
# OPENAI_EVAL_MODEL=
# Optional direct OpenAI-compatible proxy/base URL and account routing.
# Ignored when AI_GATEWAY_API_KEY is configured.
# OPENAI_HOST=
# OPENAI_ORGANIZATION=
# OPENAI_PROJECT=
# Optional: enable Brave as a second web-search index during classifier evals.
# BRAVE_API_KEY=
# Optional: combined OpenAI + Brave web-search budget per eval case.
# BOTTLE_CLASSIFIER_EVAL_MAX_SEARCH_QUERIES=3
