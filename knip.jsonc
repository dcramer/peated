{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "workspaces": {
    ".": {
      // OpenSpec is invoked directly by the repository's change workflow.
      "ignoreDependencies": ["@fission-ai/openspec"],
      // The workflow runs the web workspace's Playwright binary via pnpm --dir.
      "ignoreBinaries": ["playwright"],
    },
    "apps/server": {
      // The eval command loads this config through a shell conditional.
      "entry": ["vitest.evals.config.mts"],
      // The binary is nested in shell conditionals that Knip cannot parse.
      "ignoreDependencies": ["dotenv-cli"],
    },
    "apps/web": {
      "entry": [
        "e2e/mock-rpc-server.mjs",
        // The action build command bundles this source into the committed action.
        "visual/diff/action.mjs",
      ],
      "ignoreDependencies": [
        // Next.js consumes this loader name from webpack/turbopack configuration.
        "@svgr/webpack",
        // Storybook loads this parser from its reactDocgen configuration value.
        "react-docgen-typescript",
      ],
    },
    "packages/bottle-classifier": {
      "entry": ["vitest.evals.config.mts"],
    },
  },
}
